# Tests are maintained in the repository and exercised by CI.  They depend on
# repository-only fixtures and workflow files, so do not ship an incomplete
# test suite in the source distribution.
prune tests
include README.ko.md
include docs/alignment-quality.md
include docs/pronunciation-dictionary.md
include docs/troubleshooting.md
graft koreanfa/runtime
include koreanfa/path.sh
global-exclude __pycache__
global-exclude *.py[cod]
